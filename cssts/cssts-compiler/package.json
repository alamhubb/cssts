{
  "name": "cssts-compiler",
  "version": "0.2.87",
  "description": "CssTs compiler - parser, AST transformer, and type generator for CSS-in-TS",
  "type": "module",
  "local": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
