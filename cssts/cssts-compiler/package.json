    "cssts-ts": "^0.2.87",
    "glogjs": "file:../../../glogjs",
    "slime-ast": "file:../../../slime/slime-ast",
    "slime-parser": "file:../../../slime/slime-parser",
    "subhuti": "file:../../../subhuti"
  },
  "devDependencies": {
    "css-tree": "^3.1.0",
    "slime-test": "file:../../../slime/slime-test",
    "tsdown": "^0.20.0-beta.3",
    "typescript": "^5.8.3"
  },
